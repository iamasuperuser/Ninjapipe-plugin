{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "ninjapipe": {
      "type": "stdio",
      "command": "node",
      "args": [
        "./server.mjs"
      ],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "NINJAPIPE_API_KEY": "${NINJAPIPE_API_KEY}"
      }
    }
  }
}
